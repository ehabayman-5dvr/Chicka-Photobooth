# Chicka Photobooth Environment Variables (Configured in Vercel Project Settings)
# Server-side environment variables (Recommended on Vercel to keep keys private):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2.5-flare

# Local dev fallback variables:
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-image-2.5-flare

# Optional: Cloudinary Cloud Archive & Direct Sharing (Configured in Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Chicka-Photobooth


