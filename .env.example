# Chicka Photobooth Environment Variables (Configured in Vercel Project Settings)
# API key for GP5 2.5 Flare / OpenAI-compatible endpoint
VITE_OPENAI_API_KEY=

# Target AI Model (Defaults to gpt-image-2.5-flare)
VITE_OPENAI_MODEL=gpt-image-2.5-flare

# Optional: Set to 'true' to run offline with bundled sample assets without calling the API
VITE_MOCK_MODE=false
